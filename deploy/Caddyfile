# HTTPS edge for SmartBook (compose.prod.yml). Caddy obtains and renews Let's Encrypt
# certificates on its own (ACME state lives in the caddy_data volume) and redirects
# HTTP to HTTPS for every site below.

{
	# Upstream error logs use the global logger, separately from access logs.
	log {
		format filter {
			wrap json
			fields {
				request>uri delete
				request>headers delete
				resp_headers delete
			}
		}
	}
}

(common) {
	encode zstd gzip
	@ai_body path /ai /ai/* /api/ai /api/ai/* /public/discover
	request_body @ai_body {
		max_size 16777216
	}
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}
	log {
		output stdout
		format filter {
			wrap json
			fields {
				request>uri delete
				request>headers delete
				resp_headers delete
			}
		}
	}
	log_append request_id {http.request.header.X-Request-Id}
}

smartbook.io.vn {
	import common
	# Book and branch pages change with the catalog, so this sitemap is built by
	# inventory-service; it must sit on this host to list this host's URLs.
	handle /sitemap-catalog.xml {
		rewrite * /public/catalog/sitemap.xml
		reverse_proxy api-gateway:3000
	}
	handle {
		# During a deploy the upstream container is briefly recreated: hold requests
		# until it is back instead of answering 502.
		reverse_proxy web:80 {
			lb_try_duration 30s
			lb_try_interval 500ms
		}
	}
}

api.smartbook.io.vn {
	import common
	# Socket.IO (/socket.io, WebSocket upgrade) goes through the same proxy; Caddy
	# handles the upgrade natively and sets X-Forwarded-For to the client IP, which
	# api-gateway trusts as exactly one proxy hop.
	reverse_proxy api-gateway:3000 {
		lb_try_duration 30s
		lb_try_interval 500ms
	}
}

www.smartbook.io.vn {
	redir https://smartbook.io.vn{uri} permanent
}
