/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model outbound_orders {
  id                            String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  outbound_number               String                 @unique @db.VarChar(40)
  warehouse_id                  String                 @db.Uuid
  outbound_type                 String                 @db.VarChar(30)
  status                        String                 @default("DRAFT") @db.VarChar(20)
  requested_by_user_id          String                 @db.Uuid
  approved_by_user_id           String?                @db.Uuid
  processed_by_user_id          String?                @db.Uuid
  outbound_assigned_user_id     String?                @db.Uuid
  outbound_assigned_at          DateTime?              @db.Timestamptz(6)
  outbound_assigned_by_user_id  String?                @db.Uuid
  reference_type                OutboundReferenceType  @default(OTHER)
  external_reference            String?
  requested_at                  DateTime               @default(now()) @db.Timestamptz(6)
  completed_at                  DateTime?              @db.Timestamptz(6)
  note                          String?
  created_at                    DateTime               @default(now()) @db.Timestamptz(6)
  updated_at                    DateTime               @default(now()) @db.Timestamptz(6)
  outbound_order_items          outbound_order_items[]
  warehouses                    warehouses             @relation(fields: [warehouse_id], references: [id], onUpdate: NoAction)
  picking_tasks                 picking_tasks[]

  @@index([status, requested_at], map: "idx_outbound_orders_status")
}

enum OutboundReferenceType {
  TRANSFER_TO_STORE
  WAREHOUSE_TRANSFER
  RETURN_TO_SUPPLIER
  SALES_ORDER
  INTERNAL_REQUEST
  ISSUE_REQUEST
  RESERVATION
  LOAN_REQUEST
  MAINTENANCE
  INVENTORY_ADJUSTMENT
  DAMAGED_RETURN
  PROMOTION
  OTHER
}

model outbound_reference_sequences {
  reference_type OutboundReferenceType @id
  last_number    Int                   @default(0)
  updated_at     DateTime              @default(now()) @db.Timestamptz(6)
}

