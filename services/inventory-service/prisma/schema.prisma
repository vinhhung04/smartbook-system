  book_variants_corrected  book_variants?          @relation("smart_receiving_corrected_variants", fields: [corrected_variant_id], references: [id], onUpdate: NoAction)
  goods_receipt_items      goods_receipt_items?    @relation(fields: [goods_receipt_item_id], references: [id], onUpdate: NoAction)

  @@index([smart_receiving_draft_id], map: "idx_smart_receiving_items_draft_id")
  @@index([match_status], map: "idx_smart_receiving_items_status")
}

/// Purchase requests submitted by warehouse staff for manager review.
/// Staff cannot create POs directly; they submit a request and manager converts to PO.
model purchase_requests {
  id                    String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  request_number        String          @unique @db.VarChar(40)
  created_by_user_id    String          @db.Uuid
  warehouse_id          String          @db.Uuid
  book_variant_id       String?         @db.Uuid
  book_title_hint       String?         @db.VarChar(255)
  quantity_requested    Int
  reason                String          @default("OTHER") @db.VarChar(30)
  note                  String?
  status                String          @default("PENDING") @db.VarChar(20)
  approved_by_user_id   String?         @db.Uuid
  rejected_by_user_id   String?         @db.Uuid
  approved_at           DateTime?       @db.Timestamptz(6)
  rejected_at           DateTime?       @db.Timestamptz(6)
  rejection_reason      String?
  purchase_order_id     String?         @db.Uuid
  created_at            DateTime        @default(now()) @db.Timestamptz(6)
  updated_at            DateTime        @default(now()) @db.Timestamptz(6)
  warehouses            warehouses      @relation(fields: [warehouse_id], references: [id], onUpdate: NoAction)
  book_variants         book_variants?  @relation(fields: [book_variant_id], references: [id], onUpdate: NoAction)
  purchase_orders       purchase_orders? @relation(fields: [purchase_order_id], references: [id], onUpdate: NoAction)

  @@index([created_by_user_id], map: "idx_purchase_requests_user")
  @@index([status, created_at], map: "idx_purchase_requests_status")
}

/// Warehouse exception reports created by staff for shortage, overage, or damage.
/// Manager reviews and resolves; stock is NOT adjusted automatically.
model warehouse_exception_reports {
  id                   String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  report_number        String          @unique @db.VarChar(40)
  created_by_user_id   String          @db.Uuid
  warehouse_id         String          @db.Uuid
  task_type            String          @db.VarChar(20)
  task_id              String          @db.Uuid
  goods_receipt_id     String?         @db.Uuid
  exception_type       String          @db.VarChar(30)
  book_variant_id      String?         @db.Uuid
  expected_qty         Int?
  actual_qty           Int?
  note                 String
  evidence_notes       String?
  status               String          @default("OPEN") @db.VarChar(20)
  resolved_by_user_id  String?         @db.Uuid
  resolved_at          DateTime?       @db.Timestamptz(6)
  resolution_notes     String?
  assigned_to_user_id  String?         @db.Uuid
  assigned_at          DateTime?       @db.Timestamptz(6)
  assigned_by_user_id  String?         @db.Uuid
  created_at           DateTime        @default(now()) @db.Timestamptz(6)
  updated_at           DateTime        @default(now()) @db.Timestamptz(6)
  warehouses           warehouses      @relation(fields: [warehouse_id], references: [id], onUpdate: NoAction)
  goods_receipts       goods_receipts? @relation(fields: [goods_receipt_id], references: [id], onUpdate: NoAction)
  book_variants        book_variants?  @relation(fields: [book_variant_id], references: [id], onUpdate: NoAction)

  @@index([created_by_user_id], map: "idx_warehouse_exception_reports_user")
  @@index([assigned_to_user_id], map: "idx_warehouse_exception_reports_assigned")
  @@index([status, created_at], map: "idx_warehouse_exception_reports_status")
}

/// Generic staff tasks created by manager for warehouse staff.
model staff_tasks {
  id                   String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title                String      @db.VarChar(255)
  description          String?
  task_type            String      @default("GENERAL") @db.VarChar(30)
  priority             String      @default("MEDIUM") @db.VarChar(20)
  status               String      @default("OPEN") @db.VarChar(20)
  assignee_user_id     String      @db.Uuid
  assigned_by_user_id  String      @db.Uuid
  warehouse_id         String?     @db.Uuid
  related_entity_type  String?     @db.VarChar(50)
  related_entity_id    String?     @db.Uuid
  due_date             DateTime?   @db.Timestamptz(6)
  completed_at         DateTime?   @db.Timestamptz(6)
  created_at           DateTime    @default(now()) @db.Timestamptz(6)
  updated_at           DateTime    @default(now()) @db.Timestamptz(6)
  warehouses           warehouses? @relation(fields: [warehouse_id], references: [id], onUpdate: NoAction)

  @@index([assignee_user_id], map: "idx_staff_tasks_assignee")
  @@index([status, created_at], map: "idx_staff_tasks_status")
}
