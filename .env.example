# Shared environment variables for docker-compose services
# Copy to .env before running Docker stack.

POSTGRES_USER=user
POSTGRES_PASSWORD=GENERATE_POSTGRES_PASSWORD
POSTGRES_DB=inventory

DB_HOST=db
DB_PORT=5432
DB_USER=user
DB_PASSWORD=GENERATE_POSTGRES_PASSWORD
DB_NAME=inventory
AUTH_DB_NAME=auth_db
INVENTORY_DB_NAME=inventory_db
BORROW_DB_NAME=borrow_db
AI_DB_NAME=ai_db

# Read-only Postgres role for analytics-service — it only aggregates data owned by
# inventory-service/borrow-service and must never write to their databases.
ANALYTICS_DB_USER=analytics_reader
ANALYTICS_DB_PASSWORD=GENERATE_ANALYTICS_PASSWORD

JWT_SECRET=GENERATE_JWT_SECRET
JWT_EXPIRES_IN=2h

# Internal service-to-service key for WebSocket push events
INTERNAL_SERVICE_KEY=GENERATE_INTERNAL_KEY

# RabbitMQ — transactional outbox publisher / event consumers (SB-03/SB-04)
RABBITMQ_USER=smartbook
RABBITMQ_PASSWORD=GENERATE_RABBITMQ_PASSWORD

ALLOWED_ORIGINS=http://localhost:5173
SOCKET_CORS_ORIGIN=http://localhost:5173

PGADMIN_DEFAULT_EMAIL=admin@admin.com
PGADMIN_DEFAULT_PASSWORD=GENERATE_PGADMIN_PASSWORD

# Used by frontend in local runtime
VITE_API_BASE_URL=http://localhost:3000
VITE_AUTH_BASE_URL=http://localhost:3000
VITE_AI_BASE_URL=http://localhost:3000/ai
VITE_GATEWAY_BASE_URL=http://localhost:3000

# Optional frontend health-check overrides for the admin system monitor
VITE_GATEWAY_HEALTH_URL=http://localhost:3000/health
VITE_GATEWAY_READY_URL=http://localhost:3000/ready
VITE_GATEWAY_SYSTEM_HEALTH_URL=http://localhost:3000/system/health
VITE_AI_HEALTH_URL=http://localhost:3000/ai/health

# Optional contact details shown on the customer "Hỗ trợ & Liên hệ" page
VITE_LIBRARY_SUPPORT_PHONE=1900 1234
VITE_LIBRARY_SUPPORT_EMAIL=hotro@smartbook.vn
VITE_LIBRARY_SUPPORT_HOURS=8:00 – 20:00, Thứ 2 – Chủ nhật

# /auth/login + /auth/register attempts allowed per IP per 15 minutes. Leave at the
# default (10) for local/production; CI raises this so scripts/*.mjs can log in as
# several roles back-to-back without tripping brute-force protection.
AUTH_LOGIN_RATE_LIMIT_MAX=10

# Packing Station: seconds the camera keeps recording after the last scan before Packing
# auto-completes — staff still needs to box/tape the order during this window. Change the
# value here (no code change needed) if the real packing process needs more/less time.
PACKING_RECORD_DELAY_SECONDS=15

# OpenRouter — the sole AI inference backend this service depends on. Every AI
# feature routes through it: chat, the tool-calling assistant/agent, NLU intent
# classification, ISBN enrichment, book summary, storage-suggestion explanations,
# nightly briefing, cover-photo OCR, packing-photo verification, and semantic-search
# embeddings. No Ollama, no local chat/vision model, no GPU required. Anthropic and
# Groq were also removed — OpenRouter/Qwen is the one cloud LLM this service calls.
# Do NOT hard-code the API key anywhere else, and never send it to the frontend.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Verified against the raw https://openrouter.ai/api/v1/models JSON on 2026-09-15
# ("id": "qwen/qwen3.7-flash" - supports tools/tool_choice/response_format/vision
# input, 1M context). Same model used for text, tool-calling and vision/OCR — split
# into three vars below only so each can be tuned independently later if needed.
OPENROUTER_TEXT_MODEL=qwen/qwen3.7-flash
OPENROUTER_ASSISTANT_MODEL=qwen/qwen3.7-flash
OPENROUTER_VISION_MODEL=qwen/qwen3.7-flash
# Model to retry once (same OpenRouter key) if the primary model errors. Empty = off.
# Must also be an OpenRouter model — there is no fallback to a local/offline provider.
OPENROUTER_FALLBACK_MODEL=
# Max characters one tool result contributes to the /ai/assistant prompt (tool_context.py).
# Most tools render via evidence.py's extractors (a handful of labeled lines, well under
# this); this is the safety net for a tool with no extractor.
ASSISTANT_TOOL_CONTEXT_CHARS=2000

# Embedding model for semantic search (book search, internal-doc FAQ retrieval via
# /ai/chat's GENERAL_QUERY fallback). dimensions is ALWAYS sent in the request to cut
# the vector down to match the database's fixed vector(768) column (schema.sql) —
# qwen3-embedding-8b defaults to 4096 dimensions, do not drop this parameter.
OPENROUTER_EMBED_MODEL=qwen/qwen3-embedding-8b
OPENROUTER_EMBED_DIMENSIONS=768
OPENROUTER_EMBED_TIMEOUT_SECONDS=30

# RAG abstention (retrieval_confidence.py, sau RRF): tắt để find_relevant() không còn ẩn kết quả
# khi quyết định là NO_EVIDENCE — dùng để tái lập baseline (eval/eval_rag.py --abstention off).
RAG_ABSTENTION_ENABLED=true
# Ngưỡng CONFIDENT_MATCH/UNCERTAIN/NO_EVIDENCE, riêng theo corpus. Giá trị mặc định trong code
# (retrieval_confidence.py) đã qua calibration thật trên eval/rag_dataset.json — chỉ override khi
# corpus/embedding model đổi đủ nhiều để cần chạy lại eval/calibrate_rag.py.
# BOOK_CONF_TAU_CONFIDENT=0.66
# BOOK_CONF_TAU_EVIDENCE=0.25
# DOC_CONF_TAU_CONFIDENT=0.66
# DOC_CONF_TAU_EVIDENCE=0.35

# ISBN metadata lookup — tắt WorldCat mặc định để lookup nhanh hơn
GOOGLE_BOOKS_API_BASE_URL=https://www.googleapis.com/books/v1/volumes
OPEN_LIBRARY_API_BASE_URL=https://openlibrary.org/api/books
# Gốc site OL (mặc định https://openlibrary.org) — dùng khi bổ sung description từ edition/work .json
OPEN_LIBRARY_SITE_ORIGIN=https://openlibrary.org
BOOK_LOOKUP_TIMEOUT_SECONDS=15
ENABLE_WORLDCAT_LOOKUP=false
# API key Google Books để tăng quota (tùy chọn)
GOOGLE_BOOKS_API_KEY=

# Marketplace lookup (Fahasa / Tiki / Vinabook)
ENABLE_MARKETPLACE_LOOKUP=true
# Field-level ISBN retrieval: sau lookup Google/Open Library, chỉ gọi Tiki/Vinabook/Fahasa/web
# cho field quan trọng còn thiếu. Mặc định tắt (hành vi cũ: gọi tất cả song song).
ENABLE_FIELD_LEVEL_ISBN_RETRIEVAL=false
ENABLE_METADATA_INTELLIGENCE_V2=false
# Field-level Metadata Evidence Fusion (isbn_fusion.py): "evidence" chuẩn hoá + gộp nhóm nguồn
# đồng thuận trước khi chọn giá trị field; "prior" là thuật toán cũ (nguồn reliability cao nhất
# thắng tuyệt đối), giữ lại để so sánh/rollback — xem eval/metadata_fusion/run_eval.py.
ISBN_FUSION_MODE=evidence
ISBN_LOOKUP_TOTAL_BUDGET_SECONDS=45
# TTL cache khi kết quả chưa đầy đủ hoặc có provider lỗi (giây)
ISBN_INCOMPLETE_CACHE_TTL_SECONDS=600
BOOK_MARKETPLACE_TIMEOUT_SECONDS=30
# CloakBrowser headless fallback — chỉ dùng cho Fahasa khi httpx thất bại. Mặc định tắt.
ENABLE_FAHA_CLOAKBROWSER=false
BOOK_BROWSER_TIMEOUT_SECONDS=20
# Ngưỡng cứng cho 1 phiên CloakBrowser (launch + goto + evaluate), chạy trong subprocess
# riêng (fahasa_browser.py) và bị SIGKILL cả process group nếu vượt quá — cần thiết vì
# timeout truyền cho page.goto() không chặn được launch() bị treo (từng quan sát treo
# 34+ phút với 0 tiến trình browser nào được tạo, do binary Chromium của CloakBrowser
# chưa được cache — xem AI_SERVICE.md phần CloakBrowser binary cache).
FAHASA_BROWSER_HARD_TIMEOUT_SECONDS=35
# Thời gian tối đa chờ (poll) response API tìm kiếm nội bộ của Fahasa sau khi trang bắt
# đầu tải — thay cho việc chờ trang "rảnh mạng hoàn toàn" (không bao giờ đạt được vì
# chat widget/analytics chạy nền liên tục).
FAHASA_SEARCH_RESPONSE_WAIT_SECONDS=8

# "Tìm sách bằng ảnh bìa" — CLIP visual embedding (local, CPU) + OpenRouter vision OCR fusion
CLIP_MODEL_NAME=openai/clip-vit-base-patch32
COVER_OCR_MAX_TOKENS=200
COVER_OCR_TIMEOUT_SECONDS=20
COVER_SEARCH_VISUAL_THRESHOLD=0.80
COVER_SEARCH_MIN_CONFIDENCE=0.5
COVER_SEARCH_VISUAL_WEIGHT=0.6
COVER_SEARCH_RESULT_LIMIT=5

# Packing-photo verification (OpenRouter vision) — see packing-evidence-ai.service.js
PACKING_VISION_MAX_TOKENS=200
PACKING_VISION_TIMEOUT_SECONDS=15

# Receipt/invoice OCR (OpenRouter vision) — /scan-receipt
RECEIPT_VISION_MAX_TOKENS=1200
RECEIPT_VISION_TIMEOUT_SECONDS=30

# "Thu thu AI truc dem" — autonomous agent that reviews the system nightly and
# leaves a morning briefing as an AI action for staff to confirm (ai-service).
ENABLE_NIGHTLY_BRIEFING=true
NIGHTLY_BRIEFING_HOUR_VN=2
# Long timeout on purpose: this is a background job nobody is waiting on, with a
# larger prompt than a normal chat turn — the live chat endpoint's own 12s timeout
# (CHAT_LLM_TIMEOUT_SECONDS) is tuned for a person waiting and is too short here
# (verified live: even a normally-fast cloud provider exceeded 12s on this prompt).
NIGHTLY_BRIEFING_LLM_TIMEOUT_SECONDS=180

# Base URL of the customer web app — used to build links back into it from
# outside the SPA (auth-service email links, borrow-service's VNPay return page).
FRONTEND_URL=http://localhost:5173

# VNPay sandbox — real self-service fine payment. Leave TMN_CODE/HASH_SECRET
# blank until you register a sandbox merchant at https://sandbox.vnpayment.vn —
# the create-payment endpoint returns a clear 503 until both are set.
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:3000/webhooks/vnpay/return

