# Shared environment variables for docker-compose services
# Copy to .env before running Docker stack.

POSTGRES_USER=user
POSTGRES_PASSWORD=GENERATE_POSTGRES_PASSWORD
POSTGRES_DB=inventory

DB_HOST=db
DB_PORT=5432
DB_USER=user
DB_PASSWORD=GENERATE_POSTGRES_PASSWORD
DB_NAME=inventory
AUTH_DB_NAME=auth_db
INVENTORY_DB_NAME=inventory_db
BORROW_DB_NAME=borrow_db
AI_DB_NAME=ai_db

# Read-only Postgres role for analytics-service — it only aggregates data owned by
# inventory-service/borrow-service and must never write to their databases.
ANALYTICS_DB_USER=analytics_reader
ANALYTICS_DB_PASSWORD=GENERATE_ANALYTICS_PASSWORD

JWT_SECRET=GENERATE_JWT_SECRET
JWT_EXPIRES_IN=2h

# Internal service-to-service key for WebSocket push events
INTERNAL_SERVICE_KEY=GENERATE_INTERNAL_KEY

# RabbitMQ — transactional outbox publisher / event consumers (SB-03/SB-04)
RABBITMQ_USER=smartbook
RABBITMQ_PASSWORD=GENERATE_RABBITMQ_PASSWORD

ALLOWED_ORIGINS=http://localhost:5173
SOCKET_CORS_ORIGIN=http://localhost:5173

PGADMIN_DEFAULT_EMAIL=admin@admin.com
PGADMIN_DEFAULT_PASSWORD=GENERATE_PGADMIN_PASSWORD

# Used by frontend in local runtime
VITE_API_BASE_URL=http://localhost:3000
VITE_AUTH_BASE_URL=http://localhost:3000
VITE_AI_BASE_URL=http://localhost:3000/ai
VITE_GATEWAY_BASE_URL=http://localhost:3000

# Optional frontend health-check overrides for the admin system monitor
VITE_GATEWAY_HEALTH_URL=http://localhost:3000/health
VITE_GATEWAY_READY_URL=http://localhost:3000/ready
VITE_AI_HEALTH_URL=http://localhost:3000/ai/health

# Packing Station: seconds the camera keeps recording after the last scan before Packing
# auto-completes — staff still needs to box/tape the order during this window. Change the
# value here (no code change needed) if the real packing process needs more/less time.
PACKING_RECORD_DELAY_SECONDS=15

# Ollama — dùng chung 1 model text (llama3.1, hỗ trợ cả tool-calling) cho tóm tắt/chat (SUMMARY_MODEL)
# và cho /ai/assistant (ASSISTANT_MODEL), thay vì giữ 2 model riêng (llama3 cũ không hỗ trợ tool-calling).
# llava là vision model riêng, không phù hợp cho tóm tắt văn bản.
# Nhớ pull model trước: `docker compose exec ollama ollama pull llama3.1:8b-instruct-q4_0`.
SUMMARY_MODEL=llama3.1:8b-instruct-q4_0
OLLAMA_HOST=http://ollama:11434
ASSISTANT_MODEL=llama3.1:8b-instruct-q4_0
# Which backend /ai/assistant's tool-calling loop calls: "ollama" (default, fully
# offline) or "anthropic" (opt-in — requires ANTHROPIC_API_KEY below — for an eval
# A/B comparison against the local model). Demo/offline use should leave this unset.
ASSISTANT_PROVIDER=ollama
# Max characters one tool result contributes to the /ai/assistant prompt (tool_context.py).
# Most tools render via evidence.py's extractors (a handful of labeled lines, well under
# this); this is the safety net for a tool with no extractor.
ASSISTANT_TOOL_CONTEXT_CHARS=2000
# Embedding model for chatbot FAQ semantic search (separate from the chat models above).
# Requires: docker compose exec ollama ollama pull nomic-embed-text
FAQ_EMBED_MODEL=nomic-embed-text

# ISBN metadata lookup — tắt WorldCat mặc định để lookup nhanh hơn
GOOGLE_BOOKS_API_BASE_URL=https://www.googleapis.com/books/v1/volumes
OPEN_LIBRARY_API_BASE_URL=https://openlibrary.org/api/books
# Gốc site OL (mặc định https://openlibrary.org) — dùng khi bổ sung description từ edition/work .json
OPEN_LIBRARY_SITE_ORIGIN=https://openlibrary.org
BOOK_LOOKUP_TIMEOUT_SECONDS=15
ENABLE_WORLDCAT_LOOKUP=false
# API key Google Books để tăng quota (tùy chọn)
GOOGLE_BOOKS_API_KEY=

# Anthropic Claude LLM — nếu không set sẽ fallback về Ollama local.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Marketplace lookup (Fahasa / Tiki / Vinabook)
ENABLE_MARKETPLACE_LOOKUP=true
BOOK_MARKETPLACE_TIMEOUT_SECONDS=20
# CloakBrowser headless fallback — chỉ dùng cho Fahasa khi httpx thất bại. Mặc định tắt.
ENABLE_FAHA_CLOAKBROWSER=false
BOOK_BROWSER_TIMEOUT_SECONDS=15

# "Tìm sách bằng ảnh bìa" — CLIP visual embedding + OCR-text fusion
CLIP_MODEL_NAME=openai/clip-vit-base-patch32
COVER_OCR_MAX_TOKENS=200
COVER_OCR_TIMEOUT_SECONDS=90
COVER_SEARCH_VISUAL_THRESHOLD=0.80
COVER_SEARCH_MIN_CONFIDENCE=0.5
COVER_SEARCH_VISUAL_WEIGHT=0.6
COVER_SEARCH_RESULT_LIMIT=5

# "Thu thu AI truc dem" — autonomous agent that reviews the system nightly and
# leaves a morning briefing as an AI action for staff to confirm (ai-service).
ENABLE_NIGHTLY_BRIEFING=true
NIGHTLY_BRIEFING_HOUR_VN=2
# Long timeouts on purpose: this is a background job nobody is waiting on, with a
# larger prompt than a normal chat turn — the live chat endpoint's own 12s timeout
# (CHAT_LLM_TIMEOUT_SECONDS) is tuned for a person waiting and is too short here
# (verified live: even Anthropic exceeded 12s on this prompt).
NIGHTLY_BRIEFING_ANTHROPIC_TIMEOUT_SECONDS=60
NIGHTLY_BRIEFING_OLLAMA_TIMEOUT_SECONDS=180

# Base URL of the customer web app — used to build links back into it from
# outside the SPA (auth-service email links, borrow-service's VNPay return page).
FRONTEND_URL=http://localhost:5173

# VNPay sandbox — real self-service fine payment. Leave TMN_CODE/HASH_SECRET
# blank until you register a sandbox merchant at https://sandbox.vnpayment.vn —
# the create-payment endpoint returns a clear 503 until both are set.
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:3000/webhooks/vnpay/return

