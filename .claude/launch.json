{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "web", "dev"],
      "port": 5173
    },
    {
      "name": "mobile-web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@smartbook/mobile", "web"],
      "port": 8081
    },
    {
      "name": "mobile-web-local",
      "runtimeExecutable": "cmd",
      "runtimeArgs": ["/c", "set EXPO_PUBLIC_API_BASE_URL=http://localhost:3000&& pnpm --filter @smartbook/mobile exec expo start --web --clear"],
      "port": 8081
    },
    {
      "name": "web-dev",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "web", "exec", "vite", "--port", "5174"],
      "port": 5174
    }
  ]
}
