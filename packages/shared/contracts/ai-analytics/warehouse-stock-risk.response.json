        "properties": {
          "warehouse_id": { "type": "string" },
          "warehouse_name": { "type": "string" },
          "low_stock_variants": { "type": "number" },
          "out_of_stock_variants": { "type": "number" },
          "reasoning": { "type": "string" }
        }
      }
    }
  }
