{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GET /analytics/fine-summary — 200 response",
  "type": "object",
  "required": ["data"],
  "properties": {
    "data": {
      "type": "object",
      "required": ["total_unpaid", "total_paid", "total_waived", "unpaid_count", "paid_count", "by_type"],
      "properties": {
        "total_unpaid": { "type": "number" },
        "total_paid": { "type": "number" },
        "total_waived": { "type": "number" },
        "unpaid_count": { "type": "number" },
        "paid_count": { "type": "number" },
        "by_type": { "type": "array" }
      }
    }
  }
}
