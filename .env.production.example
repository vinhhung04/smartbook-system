# SmartBook production environment (VPS "smartbook", /opt/smartbook/.env, mode 600).
# Template only - deploy/scripts/init-env.sh copies it and fills every CHANGE_ME secret
# with a random hex value. Never commit the real file. Application image versions are
# NOT set here: deploy.sh writes IMAGE_TAG to state/release.env on each release.

# --- Public URLs (the web bundle bakes these in at CI build time: change both places) ---
PUBLIC_WEB_ORIGIN=https://smartbook.io.vn
PUBLIC_API_ORIGIN=https://api.smartbook.io.vn
PUBLIC_API_WS_ORIGIN=wss://api.smartbook.io.vn

# --- PostgreSQL (pgvector) - hex only: used inside postgresql:// URLs ---
POSTGRES_USER=smartbook
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=inventory
# same as POSTGRES_USER: read by the demo-seed helpers (scripts/*.mjs via seed-demo.sh)
DB_USER=smartbook
ANALYTICS_DB_USER=analytics_reader
ANALYTICS_DB_PASSWORD=CHANGE_ME

# --- Auth / service-to-service ---
JWT_SECRET=CHANGE_ME
JWT_EXPIRES_IN=2h
INTERNAL_SERVICE_KEY=CHANGE_ME
AUTH_LOGIN_RATE_LIMIT_MAX=10

# --- RabbitMQ ---
RABBITMQ_USER=smartbook
RABBITMQ_PASSWORD=CHANGE_ME

# --- AI (OpenRouter is the only inference backend; models are Qwen via OpenRouter) ---
OPENROUTER_API_KEY=
OPENROUTER_TEXT_MODEL=qwen/qwen3.7-flash
OPENROUTER_ASSISTANT_MODEL=qwen/qwen3.7-flash
OPENROUTER_VISION_MODEL=qwen/qwen3.7-flash
OPENROUTER_BOOK_OCR_MODEL=qwen/qwen3.7-flash
OPENROUTER_EMBED_MODEL=qwen/qwen3-embedding-8b
GOOGLE_BOOKS_API_KEY=
ENABLE_NIGHTLY_BRIEFING=true

# --- Email (optional: password reset / notifications) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=SmartBook Library <noreply@smartbook.io.vn>

# --- VNPay (optional; sandbox URL by default - set the live URL only with live credentials) ---
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html

# --- Operations ---
BACKUP_KEEP_DAYS=14
# off-server backup copy via rclone, e.g. gdrive:smartbook-backups (configure rclone first)
BACKUP_RCLONE_REMOTE=
# Discord/Slack-compatible webhook for healthcheck.sh alerts
ALERT_WEBHOOK_URL=
