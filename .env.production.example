# SmartBook production environment (VPS "smartbook", /opt/smartbook/.env, mode 600).
# Template only - deploy/scripts/init-env.sh copies it and fills every CHANGE_ME secret
# with a random hex value. Never commit the real file. Application image versions are
# NOT set here: deploy.sh writes IMAGE_TAG to state/release.env on each release.

# --- Public URLs (the web bundle bakes these in at CI build time: change both places) ---
PUBLIC_WEB_ORIGIN=https://smartbook.io.vn
PUBLIC_API_ORIGIN=https://api.smartbook.io.vn
PUBLIC_API_WS_ORIGIN=wss://api.smartbook.io.vn

# --- PostgreSQL (pgvector) - hex only: used inside postgresql:// URLs ---
POSTGRES_USER=smartbook
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=inventory
# same as POSTGRES_USER: read by the demo-seed helpers (scripts/*.mjs via seed-demo.sh)
DB_USER=smartbook
ANALYTICS_DB_USER=analytics_reader
ANALYTICS_DB_PASSWORD=CHANGE_ME

# --- Auth / service-to-service ---
JWT_SECRET=CHANGE_ME
JWT_EXPIRES_IN=2h
INTERNAL_SERVICE_KEY=CHANGE_ME
AUTH_LOGIN_RATE_LIMIT_MAX=10

# --- Email OTP (docs/SERVICES/EMAIL_OTP.md) ---
# HMAC key for stored codes; auth-service will not start without it. Rotating it only
# invalidates codes in flight (5 minutes), never accounts or sessions.
OTP_HMAC_SECRET=CHANGE_ME
# required: new reader accounts confirm their email before the first login (needs SMTP_*)
REGISTRATION_EMAIL_VERIFICATION=required
# off -> optional -> required, only after email delivery and recovery were tested
STAFF_EMAIL_OTP_MODE=off
AUTH_OTP_VERIFY_RATE_LIMIT_MAX=30
AUTH_OTP_RESEND_RATE_LIMIT_MAX=10

# --- RabbitMQ ---
RABBITMQ_USER=smartbook
RABBITMQ_PASSWORD=CHANGE_ME

# --- AI (OpenRouter is the only inference backend; models are Qwen via OpenRouter) ---
OPENROUTER_API_KEY=
OPENROUTER_TEXT_MODEL=qwen/qwen3.7-flash
OPENROUTER_ASSISTANT_MODEL=qwen/qwen3.7-flash
OPENROUTER_VISION_MODEL=qwen/qwen3.7-flash
OPENROUTER_BOOK_OCR_MODEL=qwen/qwen3.7-flash
OPENROUTER_EMBED_MODEL=qwen/qwen3-embedding-8b
GOOGLE_BOOKS_API_KEY=
ENABLE_NIGHTLY_BRIEFING=true

# --- Email (required for sign-up verification codes; also password reset / notifications) ---
# Use a provider that signs for smartbook.io.vn (SPF + DKIM + DMARC: docs/SERVICES/EMAIL_OTP.md).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=SmartBook Library <noreply@smartbook.io.vn>

# --- VNPay (optional; sandbox URL by default - set the live URL only with live credentials) ---
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html

# --- Operations ---
BACKUP_KEEP_DAYS=14
# Runtime identities are separate from the bootstrap/migration owner. Generate
# independent random values; existing installations must provision via owner job.
AUTH_DB_PASSWORD=GENERATE_AUTH_DB_PASSWORD
INVENTORY_DB_PASSWORD=GENERATE_INVENTORY_DB_PASSWORD
BORROW_DB_PASSWORD=GENERATE_BORROW_DB_PASSWORD
AI_DB_PASSWORD=GENERATE_AI_DB_PASSWORD
# Public GPG recipient imported on the VPS; keep the private recovery key offsite.
BACKUP_ENCRYPTION_RECIPIENT=
BACKUP_OFFSITE_REQUIRED=true
# off-server backup copy via rclone, e.g. gdrive:smartbook-backups (configure rclone first)
BACKUP_RCLONE_REMOTE=
# Discord/Slack-compatible webhook used directly by healthcheck.sh: the fallback
# path that still works when monitoring-service/Grafana/Prometheus are down.
# Grafana no longer uses it (its alerts go to monitoring-service).
ALERT_WEBHOOK_URL=
# Dead-man's switch: healthcheck.sh pings this URL after every healthy run; an
# external service (e.g. healthchecks.io) alerts when the pings stop (VPS down).
EXTERNAL_HEARTBEAT_URL=

GRAFANA_ADMIN_PASSWORD=GENERATE_GRAFANA_PASSWORD

# Monitoring & alerting (docs/MONITORING.md). Leave MONITORING_DB_PASSWORD or
# MONITORING_INGEST_TOKEN empty to deploy without the monitoring stack.
MONITORING_DB_PASSWORD=GENERATE_MONITORING_DB_PASSWORD
MONITORING_INGEST_TOKEN=GENERATE_MONITORING_INGEST_TOKEN
# 64 hex chars (openssl rand -hex 32): encrypts stored Slack/Discord webhook URLs
MONITORING_SECRET_KEY=GENERATE_MONITORING_SECRET_KEY
MONITORING_WEBHOOK_ALLOW_PUBLIC=false
MONITORING_SMTP_FROM=SmartBook Monitoring <noreply@smartbook.io.vn>
