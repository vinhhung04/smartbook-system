# Address of the SmartBook API Gateway (port 3000 in docker-compose).
#
# Local development (Expo Go / dev client on the same Wi-Fi): your computer's LAN IP.
# If unset, development builds fall back to the Expo dev server's host on port 3000.
EXPO_PUBLIC_API_BASE_URL=http://192.168.1.10:3000
#
# Release APK/AAB (EAS "preview"/"production"): the VPS gateway over HTTPS, e.g.
#   https://api.your-domain.vn
# Do not put it here — store it in EAS so it is not committed:
#   eas env:create --environment preview --name EXPO_PUBLIC_API_BASE_URL --value https://api.your-domain.vn
# app.config.js refuses to build a release with a missing, placeholder, http:// or localhost URL.

# Optional: budget for OCR/cover-recognition calls in milliseconds (default 150000).
# EXPO_PUBLIC_AI_TIMEOUT_MS=150000
