{
  "expo": {
    "name": "SmartBook Picking",
    "slug": "mobile",
    "scheme": "smartbookpicking",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.smartbook.picking",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#1D1A4A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "SmartBook dùng camera để quét mã vạch/QR, chụp ảnh bìa sách và ảnh bằng chứng sự cố.",
          "recordAudioAndroid": false
        }
      ],
      "expo-status-bar",
      "expo-font"
    ]
  }
}
